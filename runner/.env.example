# ---------------------------------------------------------------------------
# Copy this file to runner/.env and fill in the two required values.
#   cp runner/.env.example runner/.env
# ---------------------------------------------------------------------------

# Full URL of the GitHub repository that will use this runner (repo scope).
# Example: https://github.com/octocat/hello-world
REPO_URL=https://github.com/YOUR_GITHUB_USER/YOUR_REPO

# Fine-grained PAT with "Administration: Read and write" on that repository.
# (Classic PAT alternative: the "repo" scope; you must be a repo admin.)
# Add "Contents: Read and write" too if you also want to push with this token.
ACCESS_TOKEN=github_pat_REPLACE_ME

# Optional: name shown under Settings -> Actions -> Runners.
RUNNER_NAME=fedora-docker-runner

# Optional: extra label(s). "self-hosted", "Linux" and "X64" are added
# automatically, so the workflow can target [self-hosted, linux, x64, python].
RUNNER_LABELS=python
